{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "听屿",
  "version": "0.1.0",
  "identifier": "com.hf.music.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "听屿",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "acceptFirstMouse": true,
        "transparent": true,
        "noRedirectionBitmap": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://*.dbankcdn.cn https://*.tingmall.com https://*.kuke.com data:; media-src 'self' https://*.dbankcdn.cn https://*.tingmall.com https://*.kuke.com blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
